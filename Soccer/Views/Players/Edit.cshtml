@model Soccer.BLL.DTO.PlayerDTO

@{
    ViewData["Title"] = "Редагування гравця";
}

<h2 class="mt-3">Редагування гравця</h2>
<hr />
<div class="row">
    <div class="col-md-5">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Id" />
            
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="BirthYear" class="form-label"></label>
                <input asp-for="BirthYear" class="form-control" type="number" />
                <span asp-validation-for="BirthYear" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="Position" class="form-label"></label>
                <input asp-for="Position" class="form-control" />
                <span asp-validation-for="Position" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="Team" class="form-label"></label>
                <select asp-for="TeamId" class="form-select" asp-items="ViewBag.ListTeams as SelectList">
                    <option value="">-- Без клубу --</option>
                </select>
                <span asp-validation-for="TeamId" class="text-danger"></span>
            </div>
            
            <div class="mt-4 mb-3">
                <button type="submit" class="btn btn-primary px-4">Зберегти</button>
                <a asp-action="Index" class="btn btn-outline-secondary ms-2">Скасувати</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}