@model Soccer.BLL.DTO.PlayerDTO

@{
    ViewData["Title"] = "Деталі гравця";
}

<h2 class="mt-3">Інформація про гравця</h2>
<hr />

<div class="card mb-4 shadow-sm" style="max-width: 600px;">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4 text-muted">
                @Html.DisplayNameFor(model => model.Name)
            </dt>
            <dd class="col-sm-8 fw-bold fs-5 text-primary">
                @Html.DisplayFor(model => model.Name)
            </dd>
            
            <dt class="col-sm-4 text-muted">
                Вік гравця:
            </dt>
            <dd class="col-sm-8">
                @(DateTime.Now.Year - Model.BirthYear) років (рік народження: @Model.BirthYear)
            </dd>
            
            <dt class="col-sm-4 text-muted">
                @Html.DisplayNameFor(model => model.Position)
            </dt>
            <dd class="col-sm-8">
                <span class="badge bg-secondary">@Html.DisplayFor(model => model.Position)</span>
            </dd>
            
            <dt class="col-sm-4 text-muted">
                @Html.DisplayNameFor(model => model.Team)
            </dt>
            <dd class="col-sm-8 fw-bold">
                @(string.IsNullOrEmpty(Model.Team) ? "Вільний агент" : Model.Team)
            </dd>
        </dl>
    </div>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">Редагувати</a>
    <a asp-action="Index" class="btn btn-outline-secondary ms-2">Повернутися до списку</a>
</div>