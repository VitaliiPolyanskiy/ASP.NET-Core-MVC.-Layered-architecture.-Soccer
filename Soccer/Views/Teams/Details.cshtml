@model Soccer.BLL.DTO.TeamDTO

@{
    ViewData["Title"] = "Деталі клубу";
}

<h2 class="mt-3">Інформація про клуб</h2>
<hr />

<div class="card mb-4 shadow-sm" style="max-width: 500px;">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4 text-muted">
                @Html.DisplayNameFor(model => model.Name)
            </dt>
            <dd class="col-sm-8 fw-bold fs-5 text-primary">
                @Html.DisplayFor(model => model.Name)
            </dd>
            
            <dt class="col-sm-4 text-muted">
                @Html.DisplayNameFor(model => model.Coach)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Coach)
            </dd>
        </dl>
    </div>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">Редагувати</a>
    <a asp-action="Index" class="btn btn-outline-secondary ms-2">Повернутися до списку</a>
</div>