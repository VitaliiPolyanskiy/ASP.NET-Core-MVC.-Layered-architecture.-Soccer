@model Soccer.BLL.DTO.TeamDTO

@{
    ViewData["Title"] = "Редагування клубу";
}

<h2 class="mt-3">Редагування клубу</h2>
<hr />
<div class="row">
    <div class="col-md-5">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Id" />
            
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="Coach" class="form-label"></label>
                <input asp-for="Coach" class="form-control" />
                <span asp-validation-for="Coach" class="text-danger"></span>
            </div>
            
            <div class="mt-4 mb-3">
                <button type="submit" class="btn btn-primary px-4">Зберегти</button>
                <a asp-action="Index" class="btn btn-outline-secondary ms-2">Скасувати</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}